<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SuDengem.MainPage"
    BackgroundColor="#EDF8FC"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,30" Spacing="15">

            <Label Text="SuDengem" FontSize="32"
                   FontAttributes="Bold" TextColor="#1686C9"
                   HorizontalOptions="Center" />

            <Label Text="Suyunu takip et, dengeni koru."
                   FontSize="14" TextColor="#62869A"
                   HorizontalOptions="Center" />

            <Border BackgroundColor="White" StrokeThickness="0"
                    StrokeShape="RoundRectangle 18" Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Kayıtlı kullanıcılar" FontSize="21"
                           FontAttributes="Bold" TextColor="#183B56" />

                    <VerticalStackLayout x:Name="UsersLayout"
                                         Spacing="10" />

                    <Button x:Name="ReturnButton"
                            Text="Takip ekranına geri dön"
                            BackgroundColor="#EAF6FC"
                            TextColor="#1686C9"
                            CornerRadius="12"
                            IsVisible="False"
                            Clicked="OnReturnClicked" />

                    <Label Text="Yeni kullanıcı oluştur"
                           FontSize="19" FontAttributes="Bold"
                           TextColor="#183B56"
                           Margin="0,10,0,0" />

                    <Label Text="Adın" TextColor="#183B56" />

                    <Entry x:Name="NameEntry"
                           Placeholder="Adını yaz"
                           TextColor="#183B56" />

                    <Label Text="Kilon (kg)" TextColor="#183B56" />

                    <Entry x:Name="WeightEntry"
                           Placeholder="Kilonu gir"
                           Keyboard="Numeric"
                           TextColor="#183B56" />

                    <Label x:Name="ResultLabel"
                           FontSize="13" TextColor="#C04A4A" />

                    <Button Text="Kullanıcı oluştur"
                            BackgroundColor="#1686C9"
                            TextColor="White"
                            CornerRadius="12" HeightRequest="50"
                            Clicked="OnCreateClicked" />

                    <Label
                        Text="Günlük su hedefin kilona göre yaklaşık olarak hesaplanır."
                        FontSize="12" TextColor="#62869A"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
